# Salin jadi `.env`, lalu pilih SATU nilai API_BASE_URL sesuai tempat kamu menjalankan app.
# Setelah mengubah .env WAJIB regenerate: dart run build_runner build --delete-conflicting-outputs
#
# Backend Markas Bangunan (CodeIgniter 3) berjalan di port 80 — BUKAN 8080.
#
#   Chrome / Flutter web     http://localhost/markas/api/v1     <-- target saat ini
#     Browser jalan di mesin yang sama, jadi localhost langsung kena Apache/MAMP.
#     Catatan: di web, request tunduk pada CORS browser. Backend sudah mengirim
#     Access-Control-Allow-Origin: * dan menjawab preflight OPTIONS dengan 204,
#     tapi pastikan Access-Control-Allow-Headers memuat `Authorization` —
#     tanpa itu semua request yang sudah login akan diblokir browser di preflight.
#
#   Android emulator (AVD)   http://10.0.2.2/markas/api/v1
#     10.0.2.2 adalah alias ke mesin host dari dalam emulator.
#     `localhost` di dalam emulator menunjuk ke emulator itu sendiri, bukan Mac kamu.
#
#   iOS Simulator            http://localhost/markas/api/v1
#     Simulator berbagi network stack dengan macOS, jadi localhost apa adanya.
#
#   HP fisik (satu WiFi)     http://<IP-LAN-Mac>/markas/api/v1
#     Cari IP-nya: ipconfig getifaddr en0
#     Pastikan Apache/MAMP listen di 0.0.0.0, bukan hanya 127.0.0.1.
#
#   Staging/production       https://<host>/api/v1
#
# Sebelum pindah ke Android/iOS: base URL http:// (cleartext) diblokir default
# oleh Android API 28+ dan ATS iOS. Perlu network security config debug +
# NSAllowsLocalNetworking. Belum dikerjakan karena target sekarang web.

API_BASE_URL=http://localhost/markas/api/v1
